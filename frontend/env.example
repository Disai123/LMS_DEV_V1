# =============================================================================
# Frontend Environment Variables
# =============================================================================
# Copy this file to .env and update the values for your environment
# For local development, use localhost URLs
# For production deployment, use your actual deployment URLs
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API URL Configuration
# -----------------------------------------------------------------------------
# This is the MOST IMPORTANT variable for deployment
# It tells the frontend where to find the backend API

# LOCAL DEVELOPMENT:
VITE_API_URL=http://localhost:5000

# PRODUCTION DEPLOYMENT (uncomment and update with your actual backend URL):
# VITE_API_URL=https://your-backend-domain.com
# 
# Examples for common hosting providers:
# - Render: https://your-app-name.onrender.com
# - Heroku: https://your-app-name.herokuapp.com
# - AWS Elastic Beanstalk: https://your-app.region.elasticbeanstalk.com
# - AWS EC2: http://your-ec2-ip:5000 or https://api.yourdomain.com
# - Railway: https://your-app.railway.app
# - Fly.io: https://your-app.fly.dev
# - Custom domain: https://api.yourdomain.com
#
# IMPORTANT: Do NOT include /api at the end - it will be added automatically

# -----------------------------------------------------------------------------
# Google OAuth Configuration
# -----------------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=626142446549-m2b07blfdipf98ircsdi402ho19nb8k9.apps.googleusercontent.com

# Get your own credentials from: https://console.cloud.google.com/apis/credentials
# Make sure to configure authorized JavaScript origins and redirect URIs

# -----------------------------------------------------------------------------
# PostHog Analytics Configuration (Optional)
# -----------------------------------------------------------------------------
VITE_POSTHOG_KEY=your_posthog_project_key_here
VITE_POSTHOG_HOST=https://app.posthog.com

# Set to 'true' to enable PostHog in development mode (default: only works in production)
VITE_POSTHOG_ENABLED=false

# Get PostHog credentials from: https://posthog.com/

# =============================================================================
# DEPLOYMENT CHECKLIST
# =============================================================================
# Before deploying to production, make sure to:
# 
# 1. Update VITE_API_URL with your actual backend URL
# 2. Verify VITE_GOOGLE_CLIENT_ID matches your backend configuration
# 3. Configure PostHog if you want analytics in production
# 4. Run 'npm run build' to create production build
# 5. Deploy the 'dist' folder to your hosting provider
# 
# =============================================================================

# =============================================================================
# TROUBLESHOOTING
# =============================================================================
# If you see "Network Error" or "Cannot connect to backend":
# 1. Verify VITE_API_URL is set correctly
# 2. Make sure backend server is running and accessible
# 3. Check CORS configuration in backend (FRONTEND_URL must match your frontend URL)
# 4. For production, ensure both frontend and backend use HTTPS (or both HTTP)
# 
# =============================================================================

NODE_ENV=development
PORT=5001
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite
DB_SYNC=false

JWT_SECRET=change-this-sankalp-jwt-secret
JWT_REFRESH_SECRET=change-this-sankalp-refresh-secret
FRONTEND_URL=http://localhost:3001

# Source GNANAMAI PostgreSQL (for db:pull)
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=5432
SOURCE_DB_USER=postgres
SOURCE_DB_PASSWORD=your_password
SOURCE_DB_DATABASE=lms_db
# SOURCE_DB_SSL=true

# Optional: path to LMS_Project backend .env if different
# SOURCE_ENV_PATH=../LMS_Project/backend/.env

# Email (optional — in-app notifications work without these)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your@gmail.com
# EMAIL_PASSWORD=your_app_password

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback
